        numericCode: "400",
    },
    "401": {
        name: "401 Unauthorized",
        short: "認証が必要です。",
        long: "<b>お探しのページにアクセスするには、ログインまたは認可が必要です。</b><br>適切なアカウントでログインをやり直してください。<br>でもわざわざBASIC認証の必要なページとか用意するつもりもないんですけどね……。",
        numericCode: "401",
    },
    unauthorized: {
        name: "401 Unauthorized",
        short: "認証が必要です。",
        long: "<b>お探しのページにアクセスするには、ログインまたは認可が必要です。</b><br>適切なアカウントでログインをやり直してください。<br>でもわざわざBASIC認証の必要なページとか用意するつもりもないんですけどね……。",
        numericCode: "401",
    },
    "402": {
        name: "402 Payment Required",
        short: "料金の支払いが必要です。",
        long: "<b>お探しのページを利用するには、支払いが要求されています。</b><br>現時点では、作者に支払いをする方法は以下のとおりです。<ul><li><a href=\"https://motchiy.com/donate\">Motchiy Server公式ページから</a>。対応形式はEメールタイプのAmazonギフトです。</li></ul><br>また現在、<b><a href=\"https://unicef.or.jp/bof/bo.html\">UNICEF</a>や<a href=\"https://jhf.or.jp/kifu\">日本心臓財団</a>等へ寄付をする</b>こと、<b>書店で問題集を購入して受験勉強をする</b>ことも提案されています。<br>それぞれの支払い方法は僕達の利益になるわけではなく、世界全体をよりよいものにするために重要なものです。ぜひご検討ください。",
        numericCode: "402",
    },
    "403": {
        name: "403 Forbidden",
        short: "アクセスが拒否されました。",
        long: "<b>お探しのページのアクセスは禁止されています。</b><br>閲覧するには適切な権限を持つユーザーとしてログインするか、さいほうへいきのリア友になる必要があります。<br>というかそんなに見たかったら、まぁ普通にサーバーマシンにログインすればいいと思います。",
        numericCode: "403",
    },
    forbidden: {
        name: "403 Forbidden",
        short: "アクセスが拒否されました。",
        long: "<b>お探しのページのアクセスは禁止されています。</b><br>閲覧するには適切な権限を持つユーザーとしてログインするか、さいほうへいきのリア友になる必要があります。<br>というかそんなに見たかったら、まぁ普通にサーバーマシンにログインすればいいと思います。",
        numericCode: "403",
    },
    "404": {
        name: "404 Not Found",
        short: "お探しのページは見つかりませんでしたにゃん……。",
        long: "<b>お探しのページは見つかりませんでした。</b><br>アドレスが間違っているか、ページが工事中で公開されていません。<br>アクセスしようとしたURLが適切なものかご確認ください。<br>以前存在したページが削除されている可能性もありますし、まだ未公開である可能性もあるので、もしご質問があればお気軽にご連絡・ご質問をください。",
        numericCode: "404",
    },
    "405": {
        name: "405 Method Not Allowed",
        short: "許可されていないHTTPメソッドです。",
        long: "<b>許可されていないメソッドを利用しようとし、失敗しました。</b><br>適切なメソッドを送信したことを確認してから、ご利用ください。",
        numericCode: "405",
    },
    "406": {
        name: "406 Not Acceptable",
        short: "受け入れられないコンテンツです。",
        long: "<b>サーバーはリクエストを理解しましたが、要求された形式では適切なレスポンスを生成できませんでした。</b><br>クライアントが指定したAcceptヘッダーなどの条件により、利用可能な形式と一致しなかった可能性があります。<br>例えば、JSONしか受け取らない設定になっているのにHTMLを要求していたり、その逆のケースが考えられます。<br>ブラウザでの閲覧でこのエラーが出る場合は、拡張機能やプロキシなどがヘッダーを書き換えている可能性もあります。<br>基本的にはページを再読み込みするか、別のブラウザや環境でアクセスしてみてください。<br>APIを利用している場合は、AcceptヘッダーやContent-Typeの設定を見直すことで解決する可能性があります。",
        numericCode: "406",
    },
    "407": {
        name: "407 Proxy Authentication Required",
        short: "プロキシ認証が必要です。",
        long: "このリクエストを処理するには、プロキシサーバーでの認証が必要ですが、適切な認証情報が提供されていません。</b><br>そのため、サーバーはリクエストを完了することができませんでした。<br>企業ネットワークや学校のWi-Fiなどでは、通信がプロキシサーバーを経由している場合があります。<br>その場合、ブラウザやシステムに正しいユーザー名・パスワードを設定していないと、このエラーが発生します。<br>ネットワークの設定を確認し、必要であればプロキシ認証情報を正しく入力してください。<br>よく分からない場合は、別の回線（モバイル通信など）からアクセスしてみると解決することもあります。",
        numericCode: "407",
    },
    "408": {
        name: "408 Request Timeout",
        short: "リクエストがタイムアウトしました。",
        long: "<b>リクエストがタイムアウトしたため、要求に答えることができませんでした。</b><br>再度やりなおすか、もしくはより短い時間で返答ができるような要求を行ってください。<br>もしくはサーバー側の通信、あるいは機械的な状況により処理に遅延が発生している場合もあります。",
        numericCode: "408",
    },
    request_timeout: {
        name: "408 Request Timeout",
        short: "リクエストがタイムアウトしました。",
        long: "<b>リクエストがタイムアウトしたため、要求に答えることができませんでした。</b><br>再度やりなおすか、もしくはより短い時間で返答ができるような要求を行ってください。<br>もしくはサーバー側の通信、あるいは機械的な状況により処理に遅延が発生している場合もあります。",
        numericCode: "408",
    },
    "409": {
        name: "409 Conflict",
        short: "リクエストが競合しています。",
        long: "<b>このリクエストはサーバーの現在の状態と競合しているため、正常に処理することができませんでした。</b><br>同時に行われた別の操作や、既存データとの不整合が原因でエラーが発生しています。<br>例えば、同じデータを複数のユーザーが同時に編集していた場合や、すでに存在する情報を重複して登録しようとした場合に発生します。<br>また、更新対象のデータがすでに削除・変更されている場合にもこのエラーになることがあります。<br>ページを再読み込みして最新の状態を取得したうえで、もう一度操作を行ってみてください。<br>APIを利用している場合は、バージョン管理や更新条件（ETagやIf-Matchなど）を見直すことで解決する可能性があります。",
        numericCode: "409",
    },
    "410": {
        name: "410 Gone",
        short: "リソースは既に削除されています。",
        long: "<b>お探しのページは何らかの理由により恒久的に削除されています。</b><br>現在のところ、このページが復旧する見込みはありません。<br>閲覧を希望する場合は下記の手段から管理人へ連絡することはできますが、おそらく戻ることはないでしょう。",
        numericCode: "410",
    },
    "411": {
        name: "411 Length Required",
        short: "コンテンツの長さが必要です。",
        long: "Content-Lengthヘッダーが含まれていないため、リクエストを受け付けられません。",
        numericCode: "411",
    },
    "412": {
        name: "412 Precondition Failed",
        short: "前提条件が失敗しました。",
        long: "リクエストヘッダーで指定された前提条件がサーバー側の評価で満たされませんでした。",
        numericCode: "412",
    },
    "413": {
        name: "413 Content Too Large",
        short: "コンテンツが大きすぎます。",
