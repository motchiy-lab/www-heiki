        numericCode: "508",
    },
    loop_detected: {
        name: "508 Loop Detected",
        short: "無限ループが検出されました。",
        long: "処理中に無限ループやリダイレクトの循環が検出されたため、処理を中断しました。",
        numericCode: "508",
