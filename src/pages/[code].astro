---
import DocumentLayout from "../layouts/DocumentLayout.astro";

export const prerender = true;

export async function getStaticPaths() {
    const codes = [
        "400",
        "401",
        "402",
        "403",
        "404",
        "405",
        "406",
        "407",
        "408",
        "409",
        "410",
        "411",
        "412",
        "413",
        "414",
        "415",
        "416",
        "417",
        "418",
        "429",
        "451",
        "500",
        "503",
        "507",
        "508",
        "810",
        "925",
        "unauthorized",
        "forbidden",
        "request_timeout",
        "teapot",
        "unavailable_for_legal_reasons",
        "insufficient_storage",
        "loop_detected",
        "rulebreak",
    ];
    return codes.map((code) => ({ params: { code } }));
}

const { code } = Astro.params;

const errorMap: Record<
    string,
    {
        name: string;
        short: string;
        long: string;
        is925?: boolean;
        numericCode: string;
    }
