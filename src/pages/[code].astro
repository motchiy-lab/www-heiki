const info = errorMap[code || "404"] || errorMap["404"];
const numericCode = info.numericCode;
const imgName = info.is925 ? "925" : numericCode;
---

<DocumentLayout title={`Heiki's Board - ${info.name}`} description={info.short}>
    <div class="documents-container">
        <h1>{info.name}</h1>
        <img
            src={`/imgs/${imgName}.jpg`}
            class="thumbnail"
            alt={info.is925 ? "ルール破ってちょーワルなセンチュリーくん" : `${info.name}なシャトランジくん`}
        />
        <Fragment set:html={info.long} />
        <p>
            <a href="/">掲示板トップページ</a>
            へ戻るか、なにかしらのバグである場合は
            <a href="https://x.com/leoved_kuru">僕のTwitter</a>
            へご連絡ください。
        </p>
    </div>
</DocumentLayout>
