        numericCode: "451",
    },
    unavailable_for_legal_reasons: {
        name: "451 Unavailable For Legal Reasons",
        short: "法的理由により利用できません。",
        long: "このコンテンツは法令上の理由または政府機関等の要求によりアクセスが制限されています。",
        numericCode: "451",
    },
    "500": {
        name: "500 Internal Server Error",
        short: "内部サーバーエラーが発生しました。",
        long: "サーバー内部で予期せぬエラーが発生しました。",
        numericCode: "500",
    },
    "503": {
        name: "503 Service Unavailable",
        short: "サービスは現在利用できません。",
        long: "サーバーがメンテナンス中であるか、過負荷のため一時的にリクエストを処理できません。",
        numericCode: "503",
    },
    "507": {
        name: "507 Insufficient Storage",
        short: "ストレージ容量が不足しています。",
        long: "サーバー上のストレージ容量が不足しているため、リクエストを完了できませんでした。",
        numericCode: "507",
