        long: "リクエストで指定されたRangeヘッダーの範囲が無効です。",
        numericCode: "416",
    },
    "417": {
        name: "417 Expectation Failed",
        short: "Expectヘッダーの条件を満たせません。",
        long: "リクエストのExpectヘッダーで指定された期待値をサーバーが満たすことができませんでした。",
        numericCode: "417",
    },
    "418": {
        name: "418 I'm a teapot.",
        short: "私はティーポットです。",
        long: "私はティーポットです。<br>残念ながらこのサイトでコーヒーを淹れることはできません。",
        numericCode: "418",
    },
    teapot: {
        name: "418 I'm a teapot.",
        short: "私はティーポットです。",
        long: "私はティーポットです。<br>残念ながらこのサイトでコーヒーを淹れることはできません。",
        numericCode: "418",
    },
    "429": {
        name: "429 Too Many Requests",
