    "810": {
        name: "810 The Pillow is Too Big",
        short: "枕が大きすぎます。",
        long: "<b>ンアーッ！枕がでかすぎます！</b><br>枕でかすぎてこのサーバーだと処理ができないってはっきりわかんだね。<br>もしあなたがウェブサイト管理者だったら、同じような810エラーページ作って、どうぞ。俺もやったんだからさ。",
        numericCode: "810",
    },
    "925": {
        name: "925 I'M BREAKING RULES!!!!",
        short: "ルール破ってちょーワルなセンチュリーくん！！！！",
        long: "このページは925とかいう見たこともないステータスコードを返すためのページだよ！！！！<br>curlコマンドとかで確認してみてね！！！！",
        is925: true,
        numericCode: "925",
