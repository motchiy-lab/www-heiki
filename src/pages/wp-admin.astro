---
import DocumentLayout from "../layouts/DocumentLayout.astro";
---

<DocumentLayout
    title="Heiki's Boardにログイン（PHPを利用しています！）"
    description="Heiki's BoardへPHPを利用しているログインフォームでログインするためのページです。"
>
    <div class="documents-container">
        <script>
            if(window.confirm('利用規約に同意の上で、脆弱なPHPフォームでのログインを行ってください。'))
            {
                if(window.confirm('このフォームでログインを行うと、非常に危険な脆弱性が修正されていないバージョンのPHPによりデータの処理が行われます。'))
                {
                    if(window.confirm('非常に危険性の高い脆弱性を含むPHP製のフォームでログインしますか？'))
                    {
                        alert('処理に失敗しました。諦め\nなさい。');
                    }
                }
            }
        </script>

        <h1>Heiki's Boardへログイン（PHP利用フォーム）</h1>
        <p>Heiki's Boardへログインします。PHPを利用しているフォームなので、非常に脆弱です……！</p>
        <div style="text-align: center; max-width: 400px; margin: 40px auto; padding: 0 20px;">
            <div style="display: flex; flex-direction: column; text-align: left; margin-bottom: 16px;">
                <label id="email-label" for="email">メールアドレス</label>
                <input type="email" id="email" required autocomplete="email">
            </div>
            <div style="display: flex; flex-direction: column; text-align: left; margin-bottom: 16px;">
                <label id="password-label" for="password">パスワード</label>
                <input type="password" id="password" required autocomplete="current-password">
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 14px; margin-bottom: 24px;">
                <div><input type="checkbox" name="remember">ログイン状態を保持</div>
                <a href="#" onclick="alert('処理に失敗しました。諦め\nなさい。')">パスワードを忘れた方</a>
            </div>
            <button style="width: 100%; box-sizing: border-box;" type="submit" onclick="reallyPHP()">脆弱なPHPが利用されていることを理解したうえでログイン</button>
        </div>
    </div>
</DocumentLayout>
